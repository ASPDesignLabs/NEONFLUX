<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- FOREGROUND SERVICE PERMISSIONS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The service's default, primary behavior is a vibration/haptics engine
         (audio is an opt-in toggle, off by default), so it's declared as
         specialUse rather than mediaPlayback - see the justification on the
         <service> element below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.type.watch" />

    <queries>
        <package android:name="com.snakesan.overseer" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Clinical/Emergency sync depends on the paired phone app, so this
             is not a standalone Wear OS app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <service
            android:name=".FluxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous haptic and optional audio biofeedback engine: translates real-time wrist motion into vibration (and, when the user enables it, a synthesized tone) for sensory grounding and self-regulation. Must keep running with the screen off or the app backgrounded so an active session doesn't silently stop." />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
